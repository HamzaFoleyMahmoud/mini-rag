struct Trie {
    struct Node {
        unordered_map<char,int>ch;
        int freq=0,isEnd=0;;
        int best_frq=0;
        string bestword="";
        int &operator[](char x) {
            return ch[x];
        }
    };
    vector<Node>trie;
    Trie() {
        trie.clear();
        newNode();
    }
    int newNode() {
        trie.emplace_back();
        return trie.size()-1;
    }
    void update(string s,int op,int frq) {
        int u=0;
        for(auto x:s) {

            if(frq>trie[u].best_frq) {
                trie[u].best_frq=frq;
                trie[u].bestword=s;
            }
            else if(trie[u].best_frq==frq) {
                 trie[u].bestword=min(s,trie[u].bestword);
            }
            if(!trie[u][x]) {
                trie[u][x]=newNode();
            }
            u=trie[u][x];
            trie[u].freq+=op;
        }
        if (frq > trie[u].best_frq) {
            trie[u].best_frq = frq;
            trie[u].bestword = s;
        } else if (frq == trie[u].best_frq) {
            trie[u].bestword = min(s, trie[u].bestword);
        }
        trie[u].isEnd++;
    }
    pair<string,int> search(string &s) {
        int u=0;
        for(auto x:s) {
            if(!trie[u][x]) return {"",-1};
            u=trie[u][x];
        }
        return {trie[u].bestword,trie[u].best_frq};
    }
