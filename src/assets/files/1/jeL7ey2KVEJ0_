struct BinaryTrie {
    const int M=31;
    struct Node {
        int ch[2]={};
        int freq=0;
        int &operator[](char x) {
            return ch[x];
        }
    };
    vector<Node>trie;
    BinaryTrie() {
        trie.clear();
        newNode();
    }
    int newNode() {
        trie.emplace_back();
        return trie.size()-1;
    }
    void update(int x,int op) {
        int u=0;
        for(int i=M-1;i>=0;i--) {
            char bit=(x>>i)&1;
            if(!trie[u][bit]) {
                trie[u][bit]=newNode();
            }
            u=trie[u][bit];
            trie[u].freq+=op;
        }
    }
    int sz(int u) {
        return trie[u].freq;
    }
    int mnXor(int x) {
        int u=0,res=0;
        for(int i=M-1;i>=0;i--) {
            char bit=(x>>i)&1;
            if(sz(trie[u][bit])) {
                u=trie[u][bit];
            }
            else {
                u=trie[u][!bit];
                res^=(1<<i);
            }
        }
        return res;
    }
};